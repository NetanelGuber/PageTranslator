    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "tinyld": "1.3.4"
  },
  "devDependencies": {
    "@types/chrome": "0.1.36",
    "@types/node": "26.6.1",
    "jsdom": "27.4.0",
    "playwright-core": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
